# ============================================
# Starmory App - Environment Configuration
# ============================================
# ⚠️ หมายเหตุ
# - แต่ละคนต้องสร้างไฟล์ .env ของตัวเอง
# - ห้าม commit ไฟล์ .env ที่มีค่าจริงขึ้น git!
# ✅ ไฟล์ .env ถูกใส่ใน .gitignore แล้ว (ปลอดภัย)
# ============================================

# Supabase Configuration
# คัดลอกค่าจาก Supabase Project Settings → API
# 1. ไปที่ https://supabase.com
# 2. เลือก project ของคุณ
# 3. ไปที่ Settings → API
# 4. คัดลอก Project URL และ anon/public key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth Configuration (Optional - ถ้าต้องการใช้ Google Sign-In)
# คัดลอกจาก Google Cloud Console
# 1. ไปที่ https://console.cloud.google.com
# 2. APIs & Services → Credentials
# 3. สร้าง OAuth 2.0 Client ID สำหรับแต่ละ Platform:
#    - iOS: เลือก iOS
#    - Android: เลือก Android
#    - Web: เลือก Web application
# 4. คัดลอก Client ID แต่ละตัวมาใส่ด้านล่าง

IOS_CLIENT=your-ios-client-id-here.apps.googleusercontent.com
ANDROID_CLIENT=your-android-client-id-here.apps.googleusercontent.com
WEB_CLIENT=your-web-client-id-here.apps.googleusercontent.com

# Gemini AI Configuration
# คัดลอกจาก Google AI Studio
# 1. ไปที่ https://aistudio.google.com
# 2. ไปที่ API Keys → Create API Key
# 3. คัดลอก API Key มาใส่ด้านล่าง

GEMINI_API_KEY=your-gemini-api-key-here
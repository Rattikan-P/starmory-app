<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget: 2×2 Compact — Starmory Personal Vocab Widget (Data State)
  Centered Word + Thai Translation (Larger Font), Top-Left Solid White Streak Badge, Bottom-Right Camera Button
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Background Photo (Matrix-scaled, contrast gradient & 28dp rounded in Kotlin) -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_placeholder" />

    <!-- 2. Top-Left: Solid White Streak Badge (🔥 Emoji + Number, slightly taller) -->
    <TextView
        android:id="@+id/widget_streak_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp"
        android:paddingLeft="10dp"
        android:paddingTop="4.5dp"
        android:paddingRight="10dp"
        android:paddingBottom="4.5dp"
        android:background="@drawable/widget_streak_pill"
        android:textSize="11.5sp"
        android:textColor="#FF1F2937"
        android:textStyle="bold"
        android:gravity="center"
        android:text="🔥7" />

    <!-- 3. Center: Word & Translation Container (Prominent, High Focus) -->
    <LinearLayout
        android:id="@+id/widget_content_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/widget_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="ADORABLE" />

        <TextView
            android:id="@+id/widget_translation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#FFF3F4F6"
            android:gravity="center"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="1.5"
            android:shadowRadius="4"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:text="น่ารัก ชวนให้อยากกอด" />
    </LinearLayout>

    <!-- 4. Bottom-Right: Circular Camera Button (38dp) -->
    <ImageView
        android:id="@+id/widget_camera_btn"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_camera_circle_btn"
        android:src="@drawable/ic_widget_camera"
        android:padding="8dp"
        android:contentDescription="Take photo" />

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget: 4×2 Standard — Starmory Personal Vocab Widget
  Style: Clean, light galaxy theme matching the Flutter app
  Layout: Left=image (rounded), Right=word content + action buttons
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <!-- Left: Vocabulary Image (rounded, square) -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_image_bg"
        android:clipToOutline="true" />

    <!-- Right: Content area -->
    <LinearLayout
        android:id="@+id/widget_content_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Date chip — top right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/widget_chip_bg"
                android:textSize="10sp"
                android:textColor="#99000000"
                android:fontFamily="sans-serif-medium"
                android:text="Sep 26" />
        </LinearLayout>

        <!-- POS badge -->
        <TextView
            android:id="@+id/widget_pos_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/widget_pos_bg"
            android:textSize="9sp"
            android:textColor="#FF7C5CFC"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp"
            android:text="ADJ" />

        <!-- English word — large, serif-style -->
        <TextView
            android:id="@+id/widget_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textColor="#FF1A1733"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Adorable" />

        <!-- Thai translation -->
        <TextView
            android:id="@+id/widget_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#CC2D264B"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:text="น่ารัก ชวนให้อยากกอด" />

        <!-- Spacer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text=""
            android:importantForAccessibility="no" />

        <!-- Bottom row: FSRS retention + action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Retention % (FSRS) -->
            <TextView
                android:id="@+id/widget_retention"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#FF7C5CFC"
                android:fontFamily="sans-serif-medium"
                android:text="87%" />

            <!-- Camera shortcut button -->
            <ImageView
                android:id="@+id/widget_camera_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_widget_camera"
                android:background="@drawable/widget_icon_btn_bg"
                android:padding="6dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Take photo" />

            <!-- Refresh button -->
            <ImageView
                android:id="@+id/widget_refresh_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_widget_refresh"
                android:background="@drawable/widget_icon_btn_bg"
                android:padding="6dp"
                android:contentDescription="Refresh" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

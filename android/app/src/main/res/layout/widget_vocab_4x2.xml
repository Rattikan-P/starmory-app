<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget: 4×2 Standard — Starmory Personal Vocab Widget (Data State)
  Left=photo (rounded), Right=streak(🔥 emoji)+date pill, word (26sp), translation, sentence quote, circular camera button (38dp)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <!-- Left: Vocabulary Image (Matrix-scaled, 18dp rounded) -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_placeholder" />

    <!-- Right: Content area -->
    <LinearLayout
        android:id="@+id/widget_content_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.45"
        android:orientation="vertical">

        <!-- Top Row: Streak Pill & Date Pill aligned to the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <!-- Streak Pill with 🔥 Emoji -->
            <TextView
                android:id="@+id/widget_streak_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingTop="4.5dp"
                android:paddingRight="10dp"
                android:paddingBottom="4.5dp"
                android:background="@drawable/widget_streak_pill"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"
                android:textSize="11.5sp"
                android:textColor="#FF1F2937"
                android:textStyle="bold"
                android:gravity="center"
                android:text="🔥7" />

            <!-- Date Pill -->
            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingTop="4.5dp"
                android:paddingRight="10dp"
                android:paddingBottom="4.5dp"
                android:background="@drawable/widget_date_pill"
                android:textSize="11.5sp"
                android:textColor="#FF7C3AED"
                android:textStyle="bold"
                android:gravity="center"
                android:text="Feb 22" />
        </LinearLayout>

        <!-- English Word (Enlarged to 26sp + Ellipsis) -->
        <TextView
            android:id="@+id/widget_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="#FF111827"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:text="ADORABLE" />

        <!-- Thai Translation (Larger + Ellipsis) -->
        <TextView
            android:id="@+id/widget_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.5sp"
            android:textColor="#FF4B5563"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            android:text="น่ารัก ชวนให้อยากกอด" />

        <!-- Example Sentence Quote (Larger + Ellipsis) -->
        <TextView
            android:id="@+id/widget_sentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textColor="#FF6B7280"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:text="“While waiting for you at the cafe, I couldn’t help but smile at this adorable little pastry sitting on my plate”" />

        <!-- Bottom Row: Camera Button aligned to bottom right (38dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|bottom">

            <ImageView
                android:id="@+id/widget_camera_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_camera_circle_btn"
                android:src="@drawable/ic_widget_camera"
                android:padding="8dp"
                android:contentDescription="Take photo" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

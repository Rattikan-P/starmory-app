<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient background for widget preview — replaces blank photo placeholder -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#9B72FF"
        android:centerColor="#7C5CFC"
        android:endColor="#5B3FD4" />
    <corners android:radius="18dp" />
</shape>

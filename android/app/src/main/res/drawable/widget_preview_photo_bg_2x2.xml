<?xml version="1.0" encoding="utf-8"?>
<!-- Full-card 24dp rounded purple gradient background for 2x2 widget preview -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#9B72FF"
        android:centerColor="#7C5CFC"
        android:endColor="#5B3FD4" />
    <corners android:radius="24dp" />
</shape>
